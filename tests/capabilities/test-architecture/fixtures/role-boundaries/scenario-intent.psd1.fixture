            Source = 'function Read-CanonicalPath { $suitePath = ''tests/capabilities/consumer-update/protocol-update.tests.ps1''; $suitePath }; function Invoke-SyntheticChild { $suitePath = ''C:/temp/synthetic-child.tests.ps1''; & $suitePath }; Invoke-SyntheticChild'
