            ExpectedTargets = @(
                'tests/capabilities/consumer-update/protocol-update.tests.ps1'
            )
        }
        @{
            Name = 'joined-variable-powershell-file'
            Source = '$suitePath = Join-Path ''C:/repo'' ''tests/capabilities/consumer-update/protocol-update.tests.ps1''; powershell -File $suitePath'
            ExpectedTargets = @(
                'tests/capabilities/consumer-update/protocol-update.tests.ps1'
            )
